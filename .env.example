# ═══════════════════════════════════════════════════════════════
#  IICE Academy CRM — Environment Configuration
#  Copy this file to .env and fill in actual values
# ═══════════════════════════════════════════════════════════════

# Django Core (REQUIRED — no defaults)
SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key;print(get_random_secret_key())
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — MySQL
DB_NAME=iice
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# OR use DATABASE_URL format:
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Email — Gmail SMTP (use App Password, NOT your account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com